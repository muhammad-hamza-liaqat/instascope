# Copy to .env and adjust. Comma-separated values become lists.

# --- app ---
APP_NAME=InstaScope
LOG_LEVEL=INFO
# Leave empty to disable auth. Clients send header: X-API-Key: <key>
API_KEYS=
CORS_ORIGINS=*

# --- storage ---
DATABASE_URL=sqlite+aiosqlite:///./storage/instascope.db
# Postgres: uv sync --extra postgres, then
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/instascope
STORAGE_DIR=storage
STORE_RAW_PAYLOADS=true
DOWNLOAD_MEDIA=true
DOWNLOAD_THUMBNAILS=true
CACHE_TTL_SECONDS=3600

# --- scraper ---
# `sessionid` cookie value(s) from logged-in Instagram accounts (browser devtools -> cookies).
# Unlocks post pagination beyond 12 and makes reels/blocked IPs work. Use throwaway accounts.
IG_SESSION_IDS=
ALWAYS_USE_SESSION=false
# Residential proxies strongly recommended for volume: http://user:pass@host:port
PROXIES=
REQUEST_TIMEOUT=20
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
MAX_CONCURRENCY=4
MIN_REQUEST_INTERVAL=1.5
MAX_PAGES=20
